{
	"name": "newdocs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/sync-wiki.mjs && vite dev",
		"build": "node scripts/sync-wiki.mjs && vite build && node scripts/pagefind.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"sync:wiki": "node scripts/sync-wiki.mjs",
		"pagefind": "node scripts/pagefind.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.28.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"bits-ui": "^2.18.1",
		"fractals-styler": "link:../packages/fractals-styler",
		"marked": "^18.0.9",
		"mode-watcher": "^1.1.0",
		"pagefind": "^1.5.2",
		"svelte-sonner": "^1.1.1",
		"tailwind-variants": "^3.3.1",
		"yaml": "^2.9.0"
	}
}
