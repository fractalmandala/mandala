{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Fractalwiki Design System Tokens",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "primitive": {
        "white": "#ffffff",
        "gray10": "#f5f5f5",
        "gray20": "#e8e8e8",
        "gray30": "#d6d6d6",
        "gray40": "#c2c2c2",
        "gray50": "#a1a1a1",
        "gray60": "#818181",
        "gray70": "#6a6a6a",
        "gray80": "#474747",
        "gray90": "#2f2f2f",
        "gray100": "#111111",
        "accent10": "#0066ff",
        "accent20": "#00a3ff",
        "accent30": "#00d4ff"
      },
      "semantic": {
        "light": {
          "bgApp": "var(--white)",
          "bgSidebar": "#f8f9fa",
          "bgCard": "var(--white)",
          "textPrimary": "var(--gray100)",
          "textSecondary": "var(--gray70)",
          "textTertiary": "var(--gray50)",
          "borderPrimary": "var(--gray30)",
          "borderSecondary": "var(--gray50)",
          "borderTertiary": "var(--gray20)"
        },
        "dark": {
          "bgApp": "#0d1117",
          "bgSidebar": "#161b22",
          "bgCard": "#21262d",
          "textPrimary": "#f0f6fc",
          "textSecondary": "#b1bac4",
          "textTertiary": "#6e7681",
          "borderPrimary": "#30363d",
          "borderSecondary": "#484f58",
          "borderTertiary": "#21262d"
        }
      }
    },
    "typography": {
      "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontMono": "ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace",
      "scale": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px"
      }
    },
    "spacing": {
      "rhythm": "4px / 8px / 12px / 16px / 24px / 32px",
      "sidebarWidth": "280px",
      "tocWidth": "220px",
      "maxContentWidth": "1100px"
    },
    "radii": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "full": "9999px"
    }
  }
}
