#!/bin/sh
# Root pre-commit gate: runs `check` in each workspace project with staged
# changes (inside `src/` or `src-tauri/`). Projects without changes are
# skipped, so ordinary commits stay fast.

set -e

changed=$(git diff --cached --name-only --diff-filter=ACMR)
projects=$(printf '%s\n' "$changed" | awk -F/ '
  ($1 == "apps" || $1 == "packages" || $1 == "sites") && ($3 == "src" || $3 == "src-tauri") { print $1 "/" $2 }
' | sort -u)

if [ -z "$projects" ]; then
  exit 0
fi

failed=0
for project in $projects; do
  if [ ! -f "$project/package.json" ]; then
    continue
  fi
  if ! grep -q '"check"' "$project/package.json"; then
    continue
  fi
  echo "pre-commit: pnpm --dir $project run check"
  if ! pnpm --dir "$project" run check; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: check failed — commit blocked" >&2
  exit 1
fi
