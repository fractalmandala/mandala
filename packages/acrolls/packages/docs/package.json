{
  "name": "@acrolls/docs",
  "version": "0.3.0",
  "description": "Fumadocs-class docs shell for SvelteKit: nested nav, TOC, breadcrumbs, pager, persisted state.",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && cp styles.css dist/styles.css",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "svelte": "^5.38.1",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "acrolls",
    "docs",
    "fumadocs",
    "sidebar",
    "sveltekit",
    "documentation",
    "toc"
  ]
}
