{
  "name": "acrolls-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:docs": "pnpm --filter @acrolls/docs build",
    "dev:example": "pnpm --filter @acrolls/example-kit dev",
    "build:example": "pnpm --filter @acrolls/example-kit build",
    "check": "pnpm -r --filter './packages/*' run check",
    "test": "pnpm -r --if-present --filter './packages/*' run test",
    "cli": "pnpm --filter @acrolls/cli exec node ./dist/index.js",
    "acrolls": "pnpm --filter @acrolls/cli exec node ./dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
