{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/docs/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/docs/[post]"
		},
		{
			"src": "^/flowbite/?(?:/__data.json)?$",
			"dest": "/flowbite"
		},
		{
			"src": "^/hero/?(?:/__data.json)?$",
			"dest": "/hero"
		},
		{
			"src": "^/ion/?(?:/__data.json)?$",
			"dest": "/ion"
		},
		{
			"src": "^/phosphor/?(?:/__data.json)?$",
			"dest": "/phosphor"
		},
		{
			"src": "^/remix/?(?:/__data.json)?$",
			"dest": "/remix"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}