{
  "description": "Fractal Agentic optional hooks (Claude-compatible). Merge into host settings or register as plugin hooks. Default profile is minimal — set FRACTAL_HOOK_PROFILE=standard|strict to expand. Requires FRACTAL_AGENTIC_ROOT or running from a tree that contains this package.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/pre-bash-safety.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/pre-no-verify.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/pre-config-protection.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/pre-gateguard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/session-start.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/periodic-essay-due.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/stop-quality-batch.js\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/stop-console-warn.js\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"/Users/amrit/fractal-agentic/plugin/hooks/scripts/periodic-essay-due.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
