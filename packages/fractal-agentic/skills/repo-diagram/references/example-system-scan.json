	"flows": [
		{
			"id": "component-page",
			"name": "Render a component doc page",
			"trigger": "Visit /components/[slug]",
			"steps": [
				"components_detail",
				"navigation_service",
				"content_components_store",
				"component_sources_service",
				"lib_components_source_store",
				"highlight_service"
			],
			"summary": "Slug resolves through the nav catalog, prose comes from the .md, and the code panel pulls real source so demos cannot drift from the package."
		},
		{
			"id": "build-prerender",
			"name": "Prerender the whole site",
			"trigger": "vite build",
			"steps": [
				"navigation_service",
				"content_components_store",
				"mdsvex_tool",
				"components_detail",
				"sitemap_route"
			],
			"summary": "Eager frontmatter globs build every catalog, MDsveX compiles the prose, and entries() enumerates each slug into the sitemap."
		},
		{
			"id": "og-image",
			"name": "Generate a social preview",
			"trigger": "Crawler requests /og/[section]/[slug].png",
			"steps": [
				"og_image_route",
				"navigation_service",
				"vercel_og_integration"
			],
			"summary": "Rasterizes 1200x630 through @vercel/og — no headless browser in the pipeline."
		},
		{
			"id": "agent-markdown",
			"name": "Serve docs as plain Markdown",
			"trigger": "Request /components/[slug].md",
			"steps": [
				"components_md_export",
				"page_markdown_service",
