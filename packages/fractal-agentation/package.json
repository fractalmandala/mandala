{
	"name": "fractal-agentation",
	"version": "0.0.1",
	"description": "Dev-mode Svelte inspector for annotating elements, text selections, groups, and areas — with layout mode for component placement and wireframing.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractal-agentation.git"
	},
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.8.0",
		"element-source": "^0.0.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"jsdom": "^26.1.0",
		"publint": "^0.3.17",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.8",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"svelte",
		"inspector",
		"annotations",
		"developer-tools",
		"layout-mode",
		"design-mode",
		"component-inspector",
		"agentation"
	]
}
