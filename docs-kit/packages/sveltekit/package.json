{
	"name": "@docs-kit/sveltekit",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsc --project tsconfig.json",
