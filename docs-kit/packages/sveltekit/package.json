		"clean": "rm -rf dist coverage"
	},
	"dependencies": {
		"@docs-kit/core": "workspace:*"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.50.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.50.0",
		"svelte": "^5.0.0",
		"typescript": "^6.0.0",
		"vitest": "^4.1.10"
	}
}
