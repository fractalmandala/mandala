		"./page": {
			"types": "./dist/page.d.ts",
			"development": "./src/page.ts",
			"default": "./dist/page.js"
		},
		"./navigation": {
			"types": "./dist/navigation.d.ts",
			"development": "./src/navigation.ts",
			"default": "./dist/navigation.js"
		},
		"./search": {
			"types": "./dist/search.d.ts",
			"development": "./src/search.ts",
			"default": "./dist/search.js"
