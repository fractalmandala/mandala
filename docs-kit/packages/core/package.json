{
	"name": "@docs-kit/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./content": {
			"types": "./dist/content.d.ts",
			"development": "./src/content.ts",
			"default": "./dist/content.js"
		},
		"./discovery": {
			"types": "./dist/discovery.d.ts",
			"development": "./src/discovery.ts",
			"default": "./dist/discovery.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"development": "./src/manifest.ts",
			"default": "./dist/manifest.js"
		},
		"./versioning": {
			"types": "./dist/versioning.d.ts",
			"development": "./src/versioning.ts",
			"default": "./dist/versioning.js"
		},
		"./i18n": {
			"types": "./dist/i18n.d.ts",
			"development": "./src/i18n.ts",
			"default": "./dist/i18n.js"
		},
		"./routing": {
			"types": "./dist/routing.d.ts",
			"development": "./src/routing.ts",
			"default": "./dist/routing.js"
		},
		"./metadata": {
			"types": "./dist/metadata.d.ts",
			"development": "./src/metadata.ts",
			"default": "./dist/metadata.js"
		},
		"./sources": {
			"types": "./dist/sources.d.ts",
			"development": "./src/sources.ts",
			"default": "./dist/sources.js"
