{
	"name": "@docs-kit/cli",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"check": "tsc --noEmit --project tsconfig.json",
		"test": "vitest run --config vitest.config.ts",
		"clean": "rm -rf dist coverage"
	},
	"dependencies": {
		"@docs-kit/core": "workspace:*",
		"@docs-kit/sources": "workspace:*",
		"@docs-kit/migration": "workspace:*",
		"@docs-kit/registry": "workspace:*",
		"@docs-kit/create": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"bin": {
		"docs": "./bin/docs.js"
	}
}
