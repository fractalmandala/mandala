{
	"openapi": "3.1.0",
	"info": {
		"title": "Acme API",
		"version": "2.0.0",
		"description": "The public Acme REST API."
	},
	"servers": [{ "url": "https://api.acme.com/v2", "description": "Production" }],
	"tags": [{ "name": "projects", "description": "Create and inspect projects." }],
	"security": [{ "apiKey": [] }],
	"paths": {
		"/projects": {
			"get": {
				"operationId": "listProjects",
				"summary": "List projects",
				"description": "Returns every project visible to the caller.",
				"tags": ["projects"],
				"parameters": [
					{
						"name": "limit",
						"in": "query",
						"description": "Maximum number of projects to return.",
						"schema": { "type": "integer", "format": "int32" }
					}
				],
				"responses": {
					"200": {
						"description": "A list of projects.",
						"content": {
							"application/json": {
								"schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } },
								"example": [{ "id": "p_1", "name": "Docs" }]
							}
						}
					}
				}
			},
			"post": {
				"operationId": "createProject",
				"summary": "Create a project",
				"tags": ["projects"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/Project" },
							"example": { "name": "Docs" }
						}
					}
				},
				"responses": { "201": { "description": "Created." } }
			}
		}
	},
	"components": {
		"schemas": {
			"Project": {
				"type": "object",
				"description": "A project.",
				"required": ["id", "name"],
				"properties": {
					"id": { "type": "string", "description": "Identifier." },
					"name": { "type": "string", "description": "Display name." },
					"status": { "type": "string", "enum": ["active", "archived"] }
				},
				"example": { "id": "p_1", "name": "Docs" }
			}
		},
		"securitySchemes": {
			"apiKey": {
				"type": "apiKey",
				"in": "header",
				"name": "X-API-Key",
				"description": "Your Acme API key."
			}
		}
	}
}
