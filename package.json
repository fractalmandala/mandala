{
	"name": "fractals",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "pnpm --filter fractalknow run check",
		"build": "pnpm --filter fractalknow run build",
		"test": "pnpm --filter fractalknow run test",
		"desktop:dev": "pnpm --filter @fractals/desktop dev",
		"desktop:check": "pnpm --filter @fractals/desktop check",
		"desktop:tauri": "pnpm --filter @fractals/desktop tauri",
		"desktop:build": "pnpm --filter @fractals/desktop build",
		"guardrails": "pnpm --filter @fractals/desktop guardrails",
		"bodha:dev": "pnpm --filter @fractals/fractalbodha dev",
		"bodha:check": "pnpm --filter @fractals/fractalbodha check",
		"bodha:tauri": "pnpm --filter @fractals/fractalbodha tauri",
		"bodha:build": "pnpm --filter @fractals/fractalbodha build",
		"builder:dev": "pnpm --filter @fractals/fractalbuilder dev",
		"builder:check": "pnpm --filter @fractals/fractalbuilder check",
		"builder:tauri": "pnpm --filter @fractals/fractalbuilder tauri",
		"builder:build": "pnpm --filter @fractals/fractalbuilder build",
		"fracta:dev": "pnpm --filter @fractals/fracta dev",
		"fracta:check": "pnpm --filter @fractals/fracta check",
