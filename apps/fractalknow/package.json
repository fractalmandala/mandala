{
  "name": "fractalknow",
  "version": "0.1.0",
  "description": "OpenKnowledge migration shell built with Tauri, SvelteKit, and indented Sass.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:unit && pnpm run test:component && pnpm run test:e2e",
    "test:unit": "svelte-kit sync && vitest run --config vitest.unit.config.ts",
    "test:component": "svelte-kit sync && vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test:sass": "node scripts/compile-sass-smoke.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@hocuspocus/provider": "^4.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-caret": "^3.29.2",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/y-tiptap": "^3.0.8",
    "fractal-agentation": "^0.0.1",
    "diff": "^9.0.0",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.7.0",
    "jsdom": "^29.1.1",
    "sass": "^1.93.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
