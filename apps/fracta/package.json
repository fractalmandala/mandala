{
	"name": "@fractals/fracta",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --outDir build",
		"test:visual": "playwright test",
		"test:markdown": "tsx tests/markdown.test.ts",
		"test:agent": "tsx tests/agent-prompt.test.ts",
		"test:json": "tsx tests/json-tree.test.ts && tsx tests/csv-grid.test.ts",
		"test:hygiene": "tsx tests/frontend-hygiene.test.ts",
		"test:motion": "tsx tests/motion.test.ts",
		"verify": "npm run check && npm run build && npm run test:markdown && npm run test:agent && npm run test:json && npm run test:hygiene && npm run test:motion && npm run test:visual && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"tauri": "tauri",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.2",
		"@types/node": "^25.9.3",
		"@types/turndown": "^5.0.6",
		"sass": "^1.100.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fractaldesign/svelte-icons": "^0.0.1",
		"@humanspeak/svelte-motion": "^0.8.2",
		"@lucide/svelte": "^1.28.0",
		"@tauri-apps/api": "^2.11.0",
		"@tiptap/core": "^3.27.1",
		"@tiptap/extension-link": "^3.27.1",
		"@tiptap/extension-placeholder": "^3.27.1",
		"@tiptap/extension-table": "^3.27.1",
		"@tiptap/extension-table-cell": "^3.27.1",
		"@tiptap/extension-table-header": "^3.27.1",
		"@tiptap/extension-table-row": "^3.27.1",
		"@tiptap/extension-task-item": "^3.27.1",
		"@tiptap/extension-task-list": "^3.27.1",
		"@tiptap/extension-underline": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"fractalsvelte": "^0.4.2",
		"katex": "^0.16.47",
		"marked": "^18.0.5",
		"mermaid": "^11.15.0",
		"pdfjs-dist": "^5.7.284",
		"turndown": "^7.2.4"
	}
}
