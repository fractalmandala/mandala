{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shradhapp",
  "version": "0.1.0",
  "identifier": "com.shradhapp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shradhapp",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
		"resizable": true,
		"maximized": true,
		"titleBarStyle": "Overlay",
		"hiddenTitle": true,
		"trafficLightPosition": {
			"x": 16,
			"y": 24
		}
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
