{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shradhapp",
  "version": "0.1.0",
  "identifier": "com.shradhapp.app",
  "build": {
    "frontendDist": "../openreel/apps/web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd openreel && OPENREEL_DESKTOP=1 pnpm --filter @openreel/web dev --port 1420",
    "beforeBuildCommand": "cd openreel && OPENREEL_DESKTOP=1 pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "resources": {
      "bundler/ffmpeg/": "ffmpeg/"
    }
  }
}
