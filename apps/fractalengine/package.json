{
	"name": "@fractals/fractalengine",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"kit-sync": "svelte-kit sync && FRACTALENGINE_BUILD_OUT_DIR=.svelte-kit-dev svelte-kit sync",
		"dev": "svelte-kit sync && FRACTALENGINE_BUILD_OUT_DIR=.svelte-kit-dev svelte-kit sync && FRACTALENGINE_BUILD_OUT_DIR=.svelte-kit-dev vite dev",
		"build": "svelte-kit sync && FRACTALENGINE_BUILD_OUT_DIR=.svelte-kit-dev svelte-kit sync && node scripts/clean-sveltekit-output.mjs && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"generate-icons": "node generate-icons.js",
		"check": "svelte-kit sync && FRACTALENGINE_BUILD_OUT_DIR=.svelte-kit-dev svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"docs:filetables": "node scripts/generate-doc-filetables.mjs",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"test:quality": "pnpm check && pnpm test:unit && pnpm lint:rust && cargo test --manifest-path src-tauri/Cargo.toml && pnpm test:e2e && pnpm build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@playwright/test": "^1.61.0",
		"@storybook/addon-a11y": "^10.5.2",
		"@storybook/addon-docs": "^10.5.2",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.5.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.2",
		"@types/node": "^25.9.3",
		"@types/turndown": "^5.0.6",
		"fractals-styler": "workspace:*",
		"jsdom": "^29.1.1",
		"sass": "^1.100.0",
		"storybook": "^10.5.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/commands": "^6.8.0",
		"@codemirror/lang-html": "^6.4.9",
		"@codemirror/lang-javascript": "^6.2.2",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.3.2",
		"@codemirror/lang-sass": "^6.0.2",
		"@codemirror/language": "^6.10.8",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.36.2",
		"@fractaldesign/svelte-icons": "^0.0.1",
		"@lezer/highlight": "^1.2.1",
		"@tauri-apps/api": "^2.11.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@tiptap/core": "^3.27.1",
		"@tiptap/extension-code-block-lowlight": "^3.27.1",
		"@tiptap/extension-highlight": "^3.27.1",
		"@tiptap/extension-image": "^3.27.1",
		"@tiptap/extension-link": "^3.27.1",
		"@tiptap/extension-placeholder": "^3.27.1",
		"@tiptap/extension-table": "^3.27.1",
		"@tiptap/extension-table-cell": "^3.27.1",
		"@tiptap/extension-table-header": "^3.27.1",
		"@tiptap/extension-table-row": "^3.27.1",
		"@tiptap/extension-task-item": "^3.27.1",
		"@tiptap/extension-task-list": "^3.27.1",
		"@tiptap/extension-underline": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"@tiptap/suggestion": "^3.27.1",
		"bits-ui": "^2.18.1",
		"codemirror": "^6.0.1",
		"dompurify": "^3.4.11",
		"highlight.js": "~11.11.1",
		"lowlight": "^3.3.0",
		"marked": "^18.0.5",
		"mermaid": "^11.15.0",
		"paneforge": "^1.0.2",
		"phosphor-svelte": "^3.1.0",
		"sv-agentation": "^0.4.0",
		"svelte-moveable": "^0.45.0",
		"svelte-splitpanes": "^8.0.12",
		"turndown": "^7.2.4"
	}
}
